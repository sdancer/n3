// Test map literals and access
mod maptest

fn create_map() {
    let m = %{:name => "Alice", :age => 30}
    print(m)
}

fn number_map() {
    let squares = %{1 => 1, 2 => 4, 3 => 9, 4 => 16}
    print(squares)
}

fn map_access() {
    let person = %{:name => "Bob", :age => 25}
    print(person[:name])
    print(person[:age])
}

fn main() -> () {
    create_map()
    number_map()
    map_access()
}
